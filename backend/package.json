{
  "name": "pseint-runner-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "test:evaluador": "node test-evaluador.mjs",
    "test:respuestas": "node test-respuestas-reportadas.mjs",
    "test:interprete": "node test-interprete.mjs",
    "audit:questions": "node --env-file=.env audit-questions.mjs",
    "test:preguntas": "node --env-file=.env audit-questions.mjs",
    "test:preguntas-generadas": "node test-preguntas-generadas.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.6",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "swipl-wasm": "^8.3.0"
  }
}
